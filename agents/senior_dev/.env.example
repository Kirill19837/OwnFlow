# OwnFlow Senior Developer Agent — environment variables

# Required: Claude API key
ANTHROPIC_API_KEY=sk-ant-...

# Optional: secret OwnFlow sends in X-Api-Key header (set this in the actor's "API key" field on OwnFlow)
AGENT_API_KEY=

# Optional: model override (default: claude-haiku-4-5)
MODEL=claude-haiku-4-5
